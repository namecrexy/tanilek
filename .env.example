# =============================================================================
# TaniLek – przykładowe zmienne środowiskowe
# Skopiuj do pliku .env (Bun wczytuje go automatycznie): cp .env.example .env
# Żadne adresy, porty ani ścieżki nie są zahardkodowane w logice aplikacji.
# =============================================================================

# Port HTTP serwera (1–65535).
PORT=3000

# Tryb uruchomienia: development | production | test
NODE_ENV=production

# Ścieżka do bazy leków w formacie Apache Parquet (ZSTD). Tworzona przez `bun run fetch-data`
# lub automatycznie z próbki demo przy pierwszym starcie serwera.
DATA_FILE_PATH=./data/leki.parquet

# Próbka CSV (35 leków) używana, gdy pobranie danych z dane.gov.pl się nie powiedzie.
FALLBACK_CSV_PATH=./tests/fixtures/sample_leki.csv

# Bazowy adres publicznego API portalu dane.gov.pl.
DANE_GOV_API_BASE=https://api.dane.gov.pl/1.4

# Frazy wyszukiwania zbioru danych w katalogu dane.gov.pl (odpytywane kolejno, rozdzielone „|”).
DANE_GOV_SEARCH_QUERY=wykaz refundowanych leków|obwieszczenie Ministra Zdrowia w sprawie wykazu refundowanych leków

# (Opcjonalnie) identyfikator konkretnego zbioru danych na dane.gov.pl – pomija wyszukiwanie.
DANE_GOV_DATASET_ID=

# (Opcjonalnie) bezpośredni adres pliku CSV/XLSX z wykazem leków refundowanych,
# np. załącznik obwieszczenia Ministra Zdrowia. Ma najwyższy priorytet.
SOURCE_URL=

# Limit czasu pojedynczego żądania API podczas pobierania danych (ms).
FETCH_TIMEOUT_MS=30000

# Domyślna i maksymalna liczba wyników wyszukiwania zwracana przez /api/search.
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=500

# Czas cache odpowiedzi API w nagłówku Cache-Control (sekundy).
API_CACHE_MAX_AGE=60

# Strona gov.pl z listą obwieszczeń MZ – źródło zapasowe, gdy w dane.gov.pl brak wykazu
# (pobierany jest załącznik XLSX najnowszego obwieszczenia). Wartość „off” wyłącza.
MZ_OBWIESZCZENIA_URL=https://www.gov.pl/web/zdrowie/obwieszczenia-ministra-zdrowia-lista-lekow-refundowanych

# Eksport CSV Rejestru Produktów Leczniczych (RPL) – źródło leków bez recepty (OTC) i kodów ATC.
# Wartość „off” wyłącza pobieranie – używany jest wtedy wbudowany zestaw popularnych leków OTC.
RPL_CSV_URL=https://rejestry.ezdrowie.gov.pl/api/rpl/medicinal-products/public-pl-report/get-csv
